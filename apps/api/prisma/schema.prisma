generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  MANAGER
  EMPLOYEE
  CLIENT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InviteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum DeviceStatus {
  ACTIVE
  UNTRUSTED
  REVOKED
}

enum LoginOutcome {
  SUCCESS
  FAILURE
  BLOCKED
}

enum AuditPermissionResult {
  ALLOWED
  DENIED
  NOT_EVALUATED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  BLOCKED
  PARTIAL
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmPipelineStatus {
  LEAD
  CONTACTED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  OVERDUE
}

enum ProposalDraftStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum FileVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum FileVersionStatus {
  ACTIVE
  SUPERSEDED
  QUARANTINED
  BLOCKED
}

enum ApprovalStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
  REQUEST_CHANGES
  CANCEL
}

enum ChatChannelType {
  INTERNAL
  CLIENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum VoiceNoteStatus {
  DRAFT
  RECORDED
  TRANSCRIPTION_REQUESTED
  TRANSCRIBED
  FAILED
  ARCHIVED
}

enum TranscriptStatus {
  PENDING
  COMPLETED
  LOW_CONFIDENCE
  FAILED
}

enum VoiceToTaskDraftStatus {
  DRAFT
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  RECORDED
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentMethod {
  MANUAL
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum ReportVisibility {
  INTERNAL
  OWNER_ONLY
  CLIENT_SAFE
}

model Tenant {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  status      TenantStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  invites     Invite[]
  sessions    Session[]
  devices     Device[]
  loginEvents LoginHistory[]
  auditEvents AuditEvent[]
  projects    Project[]
  projectMembers ProjectMember[]
  tasks       Task[]
  subtasks    Subtask[]
  leads       Lead[]
  opportunities Opportunity[]
  meetings    Meeting[]
  followUps   FollowUp[]
  proposalDrafts ProposalDraft[]
  internalNotes InternalNote[]
  fileAssets  FileAsset[]
  fileVersions FileVersion[]
  fileShares  FileShare[]
  approvalRequests ApprovalRequest[]
  approvalDecisions ApprovalDecision[]
  chatChannels ChatChannel[]
  chatMemberships ChatMembership[]
  chatMessages ChatMessage[]
  notifications Notification[]
  voiceNotes VoiceNote[]
  voiceTranscripts VoiceTranscript[]
  voiceToTaskDrafts VoiceToTaskDraft[]
  revenueRecords RevenueRecord[]
  costRecords CostRecord[]
  invoices Invoice[]
  invoiceLines InvoiceLine[]
  payments Payment[]
  reportDefinitions ReportDefinition[]
  reportRuns ReportRun[]
  dashboardWidgets DashboardWidget[]

  @@index([status])
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  displayName    String?
  status         UserStatus          @default(INVITED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  memberships    TenantMembership[]
  acceptedInvites Invite[]           @relation("AcceptedInviteUser")
  sessions       Session[]
  devices        Device[]
  loginEvents    LoginHistory[]
  auditEvents    AuditEvent[]
  projectMemberships ProjectMember[]
  assignedTasks  Task[]             @relation("AssignedTasks")
  assignedSubtasks Subtask[]        @relation("AssignedSubtasks")
  ownedLeads     Lead[]             @relation("LeadOwner")
  ownedOpportunities Opportunity[]  @relation("OpportunityOwner")
  assignedFollowUps FollowUp[]      @relation("FollowUpOwner")
  authoredInternalNotes InternalNote[] @relation("InternalNoteAuthor")
  chatMemberships ChatMembership[]
  chatMessages ChatMessage[]        @relation("ChatMessageAuthor")
  notifications Notification[]      @relation("NotificationRecipient")
  voiceNotes VoiceNote[]            @relation("VoiceNoteCreator")
  voiceToTaskDrafts VoiceToTaskDraft[] @relation("VoiceToTaskDraftCreator")

  @@index([status])
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([userId])
}

model Invite {
  id               String         @id @default(cuid())
  tenantId         String
  email            String
  role             MembershipRole
  status           InviteStatus   @default(DRAFT)
  tokenHash        String         @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acceptedBy       User?          @relation("AcceptedInviteUser", fields: [acceptedByUserId], references: [id])

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([expiresAt])
}

model Session {
  id         String        @id @default(cuid())
  tenantId   String
  userId     String
  deviceId   String?
  status     SessionStatus @default(ACTIVE)
  tokenHash  String        @unique
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device?       @relation(fields: [deviceId], references: [id])
  auditEvents AuditEvent[]

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([expiresAt])
}

model Device {
  id              String         @id @default(cuid())
  tenantId        String
  userId          String
  fingerprintHash String?
  userAgent       String?
  ipHash          String?
  status          DeviceStatus   @default(ACTIVE)
  firstSeenAt     DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        Session[]
  loginEvents     LoginHistory[]
  auditEvents     AuditEvent[]

  @@index([tenantId, userId])
  @@index([tenantId, status])
}

model LoginHistory {
  id        String       @id @default(cuid())
  tenantId  String?
  userId    String?
  deviceId  String?
  email     String
  outcome   LoginOutcome
  reason    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime     @default(now())
  tenant    Tenant?      @relation(fields: [tenantId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
  device    Device?      @relation(fields: [deviceId], references: [id])

  @@index([tenantId, email])
  @@index([tenantId, outcome])
  @@index([userId])
  @@index([createdAt])
}

model AuditEvent {
  id                       String                @id @default(cuid())
  tenantId                 String?
  actorId                  String?
  actorRole                MembershipRole?
  resourceType             String
  resourceId               String?
  action                   String
  permissionResult         AuditPermissionResult @default(NOT_EVALUATED)
  outcome                  AuditOutcome
  sessionId                String?
  deviceId                 String?
  failureCategory          String?
  redactedPayload          Json?
  correctionOfAuditEventId String?
  createdAt                DateTime              @default(now())
  tenant                   Tenant?               @relation(fields: [tenantId], references: [id])
  actor                    User?                 @relation(fields: [actorId], references: [id])
  session                  Session?              @relation(fields: [sessionId], references: [id])
  device                   Device?               @relation(fields: [deviceId], references: [id])
  correctionOf             AuditEvent?           @relation("AuditCorrection", fields: [correctionOfAuditEventId], references: [id])
  corrections              AuditEvent[]          @relation("AuditCorrection")

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, action])
  @@index([tenantId, permissionResult])
  @@index([actorId])
  @@index([sessionId])
  @@index([createdAt])
}

model Project {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      ProjectStatus   @default(ACTIVE)
  clientVisible Boolean        @default(false)
  clientScopeKey String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]

  @@index([tenantId, status])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
  @@index([tenantId, name])
}

model ProjectMember {
  id        String         @id @default(cuid())
  tenantId  String
  projectId String
  userId    String
  role      MembershipRole @default(EMPLOYEE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, userId])
  @@index([tenantId, projectId])
  @@index([tenantId, userId])
}

model Task {
  id               String       @id @default(cuid())
  tenantId         String
  projectId        String?
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  assignedToUserId String?
  clientVisible    Boolean      @default(false)
  clientScopeKey   String?
  dueAt            DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo       User?        @relation("AssignedTasks", fields: [assignedToUserId], references: [id])
  subtasks         Subtask[]

  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, projectId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
}

model Subtask {
  id               String     @id @default(cuid())
  tenantId         String
  taskId           String
  title            String
  status           TaskStatus @default(TODO)
  assignedToUserId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task             Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedTo       User?      @relation("AssignedSubtasks", fields: [assignedToUserId], references: [id])

  @@index([tenantId, taskId])
  @@index([tenantId, status])
  @@index([tenantId, assignedToUserId])
}

model Lead {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  company     String?
  email       String?
  phone       String?
  source      String?
  status      CrmPipelineStatus @default(LEAD)
  ownerUserId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User?             @relation("LeadOwner", fields: [ownerUserId], references: [id])
  opportunities Opportunity[]
  meetings    Meeting[]
  followUps   FollowUp[]

  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, email])
  @@index([tenantId, company])
}

model Opportunity {
  id              String            @id @default(cuid())
  tenantId        String
  leadId          String?
  title           String
  valueCents      Int?
  currency        String?
  status          CrmPipelineStatus @default(CONTACTED)
  ownerUserId     String?
  expectedCloseAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead            Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner           User?             @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  meetings        Meeting[]
  followUps       FollowUp[]
  proposalDrafts  ProposalDraft[]

  @@index([tenantId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, expectedCloseAt])
}

model Meeting {
  id            String        @id @default(cuid())
  tenantId      String
  leadId        String?
  opportunityId String?
  title         String
  scheduledAt   DateTime?
  status        MeetingStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, scheduledAt])
}

model FollowUp {
  id            String         @id @default(cuid())
  tenantId      String
  leadId        String?
  opportunityId String?
  title         String
  dueAt         DateTime?
  status        FollowUpStatus @default(OPEN)
  ownerUserId   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner         User?          @relation("FollowUpOwner", fields: [ownerUserId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, dueAt])
}

model ProposalDraft {
  id            String              @id @default(cuid())
  tenantId      String
  opportunityId String?
  title         String
  status        ProposalDraftStatus @default(DRAFT)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, opportunityId])
}

model InternalNote {
  id              String   @id @default(cuid())
  tenantId        String
  threadKey       String?
  resourceType    String?
  resourceId      String?
  body            String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("InternalNoteAuthor", fields: [createdByUserId], references: [id])

  @@index([tenantId, threadKey])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, createdByUserId])
  @@index([createdAt])
}

model FileAsset {
  id            String         @id @default(cuid())
  tenantId      String
  projectId     String?
  taskId        String?
  name          String
  mimeType      String?
  sizeBytes     Int?
  visibility    FileVisibility @default(INTERNAL)
  clientVisible Boolean        @default(false)
  clientScopeKey String?
  versionCount  Int            @default(0)
  createdByUserId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions      FileVersion[]
  shares        FileShare[]
  approvalRequests ApprovalRequest[]

  @@index([tenantId, visibility])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
  @@index([tenantId, projectId])
  @@index([tenantId, taskId])
}

model FileVersion {
  id              String            @id @default(cuid())
  tenantId        String
  fileAssetId     String
  versionNumber   Int
  originalName    String?
  storageKey      String?
  sizeBytes       Int?
  status          FileVersionStatus @default(ACTIVE)
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset         @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  shares          FileShare[]
  approvalRequests ApprovalRequest[]

  @@unique([tenantId, fileAssetId, versionNumber])
  @@index([tenantId, fileAssetId])
  @@index([tenantId, status])
}

model FileShare {
  id              String         @id @default(cuid())
  tenantId        String
  fileAssetId     String
  fileVersionId   String?
  visibility      FileVisibility @default(INTERNAL)
  clientVisible   Boolean        @default(false)
  clientScopeKey  String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset      @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  fileVersion     FileVersion?   @relation(fields: [fileVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId, fileAssetId])
  @@index([tenantId, fileVersionId])
  @@index([tenantId, visibility])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
}

model ApprovalRequest {
  id              String         @id @default(cuid())
  tenantId        String
  fileAssetId     String?
  fileVersionId   String?
  title           String
  status          ApprovalStatus @default(REQUESTED)
  requestedByUserId String?
  clientVisible   Boolean        @default(false)
  clientScopeKey  String?
  dueAt           DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset?     @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  fileVersion     FileVersion?   @relation(fields: [fileVersionId], references: [id], onDelete: SetNull)
  decisions       ApprovalDecision[]

  @@index([tenantId, status])
  @@index([tenantId, fileAssetId])
  @@index([tenantId, fileVersionId])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
}

model ApprovalDecision {
  id                String               @id @default(cuid())
  tenantId          String
  approvalRequestId String
  decision          ApprovalDecisionType
  note              String?
  decidedByUserId   String?
  createdAt         DateTime             @default(now())
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId, approvalRequestId])
  @@index([tenantId, decision])
  @@index([createdAt])
}

model ChatChannel {
  id              String          @id @default(cuid())
  tenantId        String
  type            ChatChannelType @default(INTERNAL)
  name            String
  resourceType    String?
  resourceId      String?
  clientScopeKey  String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     ChatMembership[]
  messages        ChatMessage[]

  @@index([tenantId, type])
  @@index([tenantId, clientScopeKey])
  @@index([tenantId, resourceType, resourceId])
}

model ChatMembership {
  id             String         @id @default(cuid())
  tenantId       String
  channelId      String
  userId         String?
  role           MembershipRole?
  clientScopeKey String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel        ChatChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, channelId])
  @@index([tenantId, userId])
  @@index([tenantId, role])
  @@index([tenantId, clientScopeKey])
}

model ChatMessage {
  id              String      @id @default(cuid())
  tenantId        String
  channelId       String
  body            String
  createdByUserId String?
  clientVisible   Boolean     @default(false)
  clientScopeKey  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel         ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy       User?       @relation("ChatMessageAuthor", fields: [createdByUserId], references: [id])

  @@index([tenantId, channelId])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
  @@index([createdAt])
}

model Notification {
  id              String             @id @default(cuid())
  tenantId        String
  recipientUserId String?
  title           String
  body            String?
  status          NotificationStatus @default(UNREAD)
  resourceType    String?
  resourceId      String?
  createdAt       DateTime           @default(now())
  readAt          DateTime?
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient       User?              @relation("NotificationRecipient", fields: [recipientUserId], references: [id])

  @@index([tenantId, recipientUserId])
  @@index([tenantId, status])
  @@index([tenantId, resourceType, resourceId])
  @@index([createdAt])
}

model VoiceNote {
  id              String          @id @default(cuid())
  tenantId        String
  projectId       String?
  taskId          String?
  title           String
  status          VoiceNoteStatus @default(RECORDED)
  languageHint    String?
  storageKey      String?
  durationSeconds Int?
  createdByUserId String?
  clientVisible   Boolean         @default(false)
  clientScopeKey  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("VoiceNoteCreator", fields: [createdByUserId], references: [id])
  transcripts     VoiceTranscript[]
  taskDrafts      VoiceToTaskDraft[]

  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([tenantId, taskId])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
}

model VoiceTranscript {
  id              String           @id @default(cuid())
  tenantId        String
  voiceNoteId     String
  status          TranscriptStatus @default(PENDING)
  language        String?
  text            String?
  confidence      Float?
  providerRef     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voiceNote       VoiceNote        @relation(fields: [voiceNoteId], references: [id], onDelete: Cascade)
  taskDrafts      VoiceToTaskDraft[]

  @@index([tenantId, voiceNoteId])
  @@index([tenantId, status])
  @@index([tenantId, language])
}

model VoiceToTaskDraft {
  id              String                 @id @default(cuid())
  tenantId        String
  voiceNoteId     String
  transcriptId    String?
  title           String
  description     String?
  suggestedDueAt  DateTime?
  suggestedPriority TaskPriority?
  status          VoiceToTaskDraftStatus @default(NEEDS_REVIEW)
  createdByUserId String?
  confirmedAt     DateTime?
  confirmedByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voiceNote       VoiceNote              @relation(fields: [voiceNoteId], references: [id], onDelete: Cascade)
  transcript      VoiceTranscript?       @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("VoiceToTaskDraftCreator", fields: [createdByUserId], references: [id])

  @@index([tenantId, voiceNoteId])
  @@index([tenantId, transcriptId])
  @@index([tenantId, status])
  @@index([tenantId, createdByUserId])
}

model RevenueRecord {
  id              String   @id @default(cuid())
  tenantId        String
  sourceType      String
  amountCents     Int
  currency        String
  projectId       String?
  invoiceId       String?
  clientScopeKey  String?
  recordedAt      DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sourceType])
  @@index([tenantId, projectId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, clientScopeKey])
  @@index([tenantId, recordedAt])
}

model CostRecord {
  id              String   @id @default(cuid())
  tenantId        String
  costType        String
  amountCents     Int
  currency        String
  projectId       String?
  vendorName      String?
  recordedAt      DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, costType])
  @@index([tenantId, projectId])
  @@index([tenantId, recordedAt])
}

model Invoice {
  id              String        @id @default(cuid())
  tenantId        String
  invoiceNumber   String
  status          InvoiceStatus @default(DRAFT)
  projectId       String?
  clientScopeKey  String?
  clientVisible   Boolean       @default(true)
  currency        String
  subtotalCents   Int           @default(0)
  totalCents      Int           @default(0)
  paidCents       Int           @default(0)
  issuedAt        DateTime?
  dueAt           DateTime?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines           InvoiceLine[]
  payments        Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([tenantId, clientVisible])
  @@index([tenantId, clientScopeKey])
  @@index([tenantId, dueAt])
}

model InvoiceLine {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceId       String
  description     String
  quantity        Int      @default(1)
  unitAmountCents Int
  totalAmountCents Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  invoiceId       String?
  amountCents     Int
  currency        String
  status          PaymentStatus @default(RECORDED)
  method          PaymentMethod @default(MANUAL)
  clientScopeKey  String?
  receivedAt      DateTime?
  recordedByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@index([tenantId, method])
  @@index([tenantId, clientScopeKey])
  @@index([tenantId, receivedAt])
}

model ReportDefinition {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  visibility      ReportVisibility @default(INTERNAL)
  definitionJson  Json?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs            ReportRun[]

  @@index([tenantId, visibility])
  @@index([tenantId, name])
  @@index([tenantId, createdByUserId])
}

model ReportRun {
  id                 String           @id @default(cuid())
  tenantId           String
  reportDefinitionId String
  visibility         ReportVisibility @default(INTERNAL)
  status             String           @default("PLACEHOLDER")
  hiddenTotalsSuppressed Boolean      @default(true)
  resultJson         Json?
  createdByUserId    String?
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)

  @@index([tenantId, reportDefinitionId])
  @@index([tenantId, visibility])
  @@index([tenantId, hiddenTotalsSuppressed])
  @@index([createdAt])
}

model DashboardWidget {
  id              String           @id @default(cuid())
  tenantId        String
  widgetKey       String
  title           String
  visibility      ReportVisibility @default(INTERNAL)
  configJson      Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, widgetKey])
  @@index([tenantId, visibility])
}
