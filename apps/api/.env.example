NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://maos:maos_password@localhost:5432/maos_db?schema=public

# JWT
# JWT_SECRET is REQUIRED and validated at startup (S-01): it must be at least
# 32 characters and must not be a placeholder. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The value below is a placeholder and will intentionally fail startup validation.
JWT_SECRET=change-me-development-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis (for sessions/realtime)
REDIS_URL=redis://localhost:6379

# S3 / Object Storage (for files & voice)
S3_BUCKET=example-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_ENDPOINT=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# AI (OpenAI / Whisper)
OPENAI_API_KEY=your-openai-api-key

# Frontend URL (for invite links)
WEB_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000

# CORS (S-05): comma-separated list of allowed browser origins.
# Falls back to WEB_URL, then to http://localhost:3000 when unset.
CORS_ORIGINS=http://localhost:3000
