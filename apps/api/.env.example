NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://maos:maos_password@localhost:5432/maos_db?schema=public

# JWT
JWT_SECRET=change-me-development-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis (for sessions/realtime)
REDIS_URL=redis://localhost:6379

# S3 / Object Storage (for files & voice)
S3_BUCKET=example-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_ENDPOINT=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# AI (OpenAI / Whisper)
OPENAI_API_KEY=your-openai-api-key

# Frontend URL (for CORS and invite links)
WEB_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000
