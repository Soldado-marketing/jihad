{
  "name": "@maos/api",
  "version": "0.1.0",
  "private": true,
  "description": "MAOS MVP API service for Sprint 1 identity foundation.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prisma:generate": "DATABASE_URL=postgresql://maos:maos@localhost:5432/maos?schema=public prisma generate",
    "prisma:validate": "DATABASE_URL=postgresql://maos:maos@localhost:5432/maos?schema=public prisma validate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.14.0",
    "prisma": "^6.0.0",
    "typescript": "^5.8.3"
  }
}
