# Both anchored to the repository root on purpose. Unanchored, these match
# ANY directory of that name at any depth: the bare 'storage' rule silently
# excluded apps/api/src/modules/storage/ from every commit, and a bare 'data'
# rule would do the same to any future src/modules/data/.
/data
/storage
local-secrets
secrets

